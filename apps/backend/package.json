    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.20.0",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
