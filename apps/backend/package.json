  "scripts": {
    "test": "node --test --experimental-test-isolation=none",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "npx sequelize-cli db:migrate --config config/config.cjs --migrations-path migrations",
    "migrate:undo": "npx sequelize-cli db:migrate:undo --config config/config.cjs --migrations-path migrations",
    "migrate:undo:all": "npx sequelize-cli db:migrate:undo:all --config config/config.cjs --migrations-path migrations"
  },
